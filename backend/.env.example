# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Neon)
# If left commented or unavailable, backend automatically falls back to pre-seeded Bihar flood memory-store
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/resqflow

# Authentication
JWT_SECRET=resqflow_super_secure_jwt_secret_key_2026_forge
JWT_EXPIRES_IN=7d

# Google Gemini API (For AI Operations Copilot)
# Leave empty to use intelligent autonomous offline fallback agent
GEMINI_API_KEY=

# External Services (Zero Paid Keys Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OSRM_BASE_URL=https://router.project-osrm.org
